NS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/index.js",[],["73","74"],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/reportWebVitals.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/App.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/config.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/Toast.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/MovieDetailEnhanced.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/ContextTable.js",[],["75","76"],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/MovieGrid.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/SearchForm.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/CandidateTable.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/RecommendTable.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/MovieCard.js",["77"],"import React from 'react';\nimport { Card, Button, Icon, Image } from 'semantic-ui-react';\nimport './MovieCard.css';\n\nclass MovieCard extends React.Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      isHovered: false\n    };\n  }\n\n  handleMouseEnter = () => {\n    this.setState({ isHovered: true });\n  };\n\n  handleMouseLeave = () => {\n    this.setState({ isHovered: false });\n  };\n\n  render() {\n    const { movie, onAdd, onMovieClick, isSelected } = this.props;\n    const { isHovered } = this.state;\n\n    return (\n      <Card \n        className={`movie-card ${isSelected ? 'selected' : ''} ${isHovered ? 'hovered' : ''}`}\n        onMouseEnter={this.handleMouseEnter}\n        onMouseLeave={this.handleMouseLeave}\n        onClick={() => onMovieClick && onMovieClick(movie)}\n      >\n        <div className=\"movie-card-poster\">\n          {movie.poster ? (\n            <Image \n              src={movie.poster} \n              alt={movie.title}\n              className=\"poster-image\"\n              onError={(e) => {\n                e.target.style.display = 'none';\n              }}\n            />\n          ) : (\n            <div className=\"poster-placeholder\">\n              <Icon name=\"film\" size=\"big\" />\n              <span>No Poster</span>\n            </div>\n          )}\n          \n          {/* Overlay on hover */}\n          <div className={`poster-overlay ${isHovered ? 'visible' : ''}`}>\n            <div className=\"overlay-content\">\n              <Button \n                circular \n                icon \n                size=\"large\"\n                color=\"red\"\n                className=\"play-button\"\n                onClick={(e) => {\n                  e.stopPropagation();\n                  onMovieClick && onMovieClick(movie);\n                }}\n              >\n                <Icon name=\"play\" />\n              </Button>\n              <Button \n                circular \n                icon \n                size=\"small\"\n                color={isSelected ? \"green\" : \"grey\"}\n                className=\"add-button\"\n                onClick={(e) => {\n                  e.stopPropagation();\n                  onAdd && onAdd(movie);\n                }}\n              >\n                <Icon name={isSelected ? \"check\" : \"plus\"} />\n              </Button>\n            </div>\n          </div>\n\n          {/* Add button badge */}\n          {!isHovered && (\n            <div className=\"add-badge\" onClick={(e) => {\n              e.stopPropagation();\n              onAdd && onAdd(movie);\n            }}>\n              <Icon name={isSelected ? \"check circle\" : \"plus circle\"} />\n            </div>\n          )}\n        </div>\n\n        <Card.Content className=\"movie-card-content\">\n          <Card.Header className=\"movie-title\">{movie.title}</Card.Header>\n          <Card.Meta className=\"movie-meta\">\n            <span className=\"movie-genre\">{movie.genre?.split(',')[0] || 'Unknown'}</span>\n            {movie.date && (\n              <span className=\"movie-date\"> • {new Date(movie.date).getFullYear()}</span>\n            )}\n          </Card.Meta>\n        </Card.Content>\n      </Card>\n    );\n  }\n}\n\nexport default MovieCard;\n\n\n\n\n\n","/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/Login.js",["78","79"],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/Hero.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/Rail.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/FocusableCard.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/constants/heroTiming.js",[],{"ruleId":"80","replacedBy":"81"},{"ruleId":"82","replacedBy":"83"},{"ruleId":"80","replacedBy":"84"},{"ruleId":"82","replacedBy":"85"},{"ruleId":"86","severity":1,"message":"87","line":2,"column":37,"nodeType":"88","messageId":"89","endLine":2,"endColumn":42},{"ruleId":"90","severity":1,"message":"91","line":518,"column":19,"nodeType":"92","endLine":518,"endColumn":93},{"ruleId":"90","severity":1,"message":"91","line":525,"column":19,"nodeType":"92","endLine":525,"endColumn":93},"no-native-reassign",["93"],"no-negated-in-lhs",["94"],["93"],["94"],"no-unused-vars","'Label' is defined but never used.","Identifier","unusedVar","jsx-a11y/anchor-is-valid","The href attribute requires a valid value to be accessible. Provide a valid, navigable address as the href value. If you cannot provide a valid href, but still need the element to resemble a link, use a button and change it with appropriate styles. Learn more: https://github.com/jsx-eslint/eslint-plugin-jsx-a11y/blob/HEAD/docs/rules/anchor-is-valid.md","JSXOpeningElement","no-global-assign","no-unsafe-negation"]