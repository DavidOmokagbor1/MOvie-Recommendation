"mtime":1765917385000,"results":"21","hashOfConfig":"14"},{"size":13587,"mtime":1766978218000,"results":"22","hashOfConfig":"14"},{"size":32321,"mtime":1766978777000,"results":"23","hashOfConfig":"14"},{"size":1416,"mtime":1766979200000,"results":"24","hashOfConfig":"14"},{"size":3156,"mtime":1766979200000,"results":"25","hashOfConfig":"14"},{"filePath":"26","messages":"27","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},"1um87p3",{"filePath":"29","messages":"30","errorCount":0,"fatalErrorCount":0,"warningCount":8,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"31","messages":"32","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"33","messages":"34","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"35","messages":"36","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"37","messages":"38","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"39","messages":"40","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"41","messages":"42","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":"28"},{"filePath":"43","messages":"44","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},{"filePath":"45","messages":"46","errorCount":0,"fatalErrorCount":0,"warningCount":9,"fixableErrorCount":0,"fixableWarningCount":0,"source":"47","usedDeprecatedRules":"28"},{"filePath":"48","messages":"49","errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0},{"filePath":"50","messages":"51","errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":null},"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/index.js",[],["52","53"],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/App.js",["54","55","56","57","58","59","60","61"],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/reportWebVitals.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/CandidateTable.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/ContextTable.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/RecommendTable.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/SearchForm.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/Toast.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/MovieDetail.js",["62"],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/MovieDetailEnhanced.js",["63","64","65","66","67","68","69","70","71"],"import React from 'react';\nimport { \n  Header, \n  Label, \n  Button, \n  Icon, \n  Image, \n  Segment, \n  Grid, \n  Divider,\n  Tab,\n  Card,\n  Rating,\n  Modal,\n  Embed\n} from 'semantic-ui-react';\nimport './MovieDetail.css';\n\nclass MovieDetailEnhanced extends React.Component {\n  constructor(props) {\n    super(props);\n    this.state = {\n      userScore: 74,\n      userVibe: null,\n      isLiked: false,\n      isBookmarked: false,\n      activeTab: 0,\n      selectedImage: null,\n      imageModalOpen: false,\n      selectedVideo: null,\n      videoModalOpen: false\n    };\n  }\n\n  formatRuntime = (minutes) => {\n    if (!minutes) return '';\n    const hours = Math.floor(minutes / 60);\n    const mins = minutes % 60;\n    return hours > 0 ? `${hours}h ${mins}m` : `${mins}m`;\n  };\n\n  formatCurrency = (amount) => {\n    if (!amount || amount === 0) return 'N/A';\n    return new Intl.NumberFormat('en-US', {\n      style: 'currency',\n      currency: 'USD',\n      minimumFractionDigits: 0,\n      maximumFractionDigits: 0\n    }).format(amount);\n  };\n\n  formatDate = (dateStr) => {\n    if (!dateStr) return '';\n    try {\n      const date = new Date(dateStr);\n      return date.toLocaleDateString('en-US', { \n        year: 'numeric', \n        month: 'long', \n        day: 'numeric' \n      });\n    } catch {\n      return dateStr;\n    }\n  };\n\n  formatReviewDate = (dateStr) => {\n    if (!dateStr) return '';\n    try {\n      const date = new Date(dateStr);\n      return date.toLocaleDateString('en-US', { \n        year: 'numeric', \n        month: 'short', \n        day: 'numeric' \n      });\n    } catch {\n      return dateStr;\n    }\n  };\n\n  handleVibeClick = (vibe) => {\n    this.setState({ userVibe: vibe });\n  };\n\n  handleLike = () => {\n    this.setState({ isLiked: !this.state.isLiked });\n  };\n\n  handleBookmark = () => {\n    this.setState({ isBookmarked: !this.state.isBookmarked });\n  };\n\n  openImageModal = (image) => {\n    this.setState({ selectedImage: image, imageModalOpen: true });\n  };\n\n  closeImageModal = () => {\n    this.setState({ imageModalOpen: false, selectedImage: null });\n  };\n\n  openVideoModal = (video) => {\n    this.setState({ selectedVideo: video, videoModalOpen: true });\n  };\n\n  closeVideoModal = () => {\n    this.setState({ videoModalOpen: false, selectedVideo: null });\n  };\n\n  renderOverview = () => {\n    const { movie, enhanced } = this.props;\n    const { userScore, userVibe, isLiked, isBookmarked } = this.state;\n    const hasEnhanced = enhanced && Object.keys(enhanced).length > 0;\n    \n    const backdropUrl = hasEnhanced && enhanced.backdrop_path;\n    const posterUrl = movie.poster || (hasEnhanced && enhanced.poster_path);\n    const genres = hasEnhanced && enhanced.genres ? enhanced.genres : \n                  (movie.genre ? movie.genre.split(',').map(g => g.trim()) : []);\n    const cast = hasEnhanced ? (enhanced.cast || []) : [];\n    const directors = hasEnhanced ? (enhanced.directors || []) : [];\n    const writers = hasEnhanced ? (enhanced.writers || []) : [];\n    const overview = hasEnhanced ? enhanced.overview : '';\n    const tagline = hasEnhanced ? enhanced.tagline : '';\n    const runtime = hasEnhanced ? enhanced.runtime : null;\n    const budget = hasEnhanced ? enhanced.budget : null;\n    const revenue = hasEnhanced ? enhanced.revenue : null;\n    const certification = hasEnhanced ? enhanced.certification : '';\n    const voteAverage = hasEnhanced ? enhanced.vote_average : null;\n    const voteCount = hasEnhanced ? enhanced.vote_count : null;\n    const releaseDate = hasEnhanced ? enhanced.release_date : movie.date;\n    const status = hasEnhanced ? enhanced.status : '';\n    const originalLanguage = hasEnhanced ? enhanced.original_language : '';\n    const trailerUrl = hasEnhanced ? enhanced.trailer_url : null;\n    const homepage = hasEnhanced ? enhanced.homepage : null;\n    const imdbId = hasEnhanced ? enhanced.imdb_id : null;\n\n    return (\n      <div className=\"overview-tab\">\n        <Grid>\n          <Grid.Row>\n            <Grid.Column width={5}>\n              <div className=\"poster-container\">\n                {posterUrl ? (\n                  <Image \n                    src={posterUrl} \n                    alt={movie.title}\n                    className=\"movie-poster\"\n                    onError={(e) => {\n                      e.target.style.display = 'none';\n                    }}\n                  />\n                ) : (\n                  <div className=\"poster-placeholder\">\n                    <Icon name=\"film\" size=\"huge\" />\n                    <p>No Poster Available</p>\n                  </div>\n                )}\n              </div>\n            </Grid.Column>\n\n            <Grid.Column width={11}>\n              <Header as=\"h1\" className=\"movie-title\">\n                {movie.title}\n                {hasEnhanced && enhanced.original_title && enhanced.original_title !== movie.title && (\n                  <span className=\"original-title\">({enhanced.original_title})</span>\n                )}\n              </Header>\n\n              <div className=\"movie-meta\">\n                {certification && (\n                  <Label size=\"large\" color=\"orange\">{certification}</Label>\n                )}\n                {releaseDate && (\n                  <span className=\"release-date\">\n                    {this.formatDate(releaseDate)} (US)\n                  </span>\n                )}\n                {genres.length > 0 && (\n                  <div className=\"genres\">\n                    {genres.map((genre, idx) => (\n                      <Label key={idx} size=\"small\">{genre}</Label>\n                    ))}\n                  </div>\n                )}\n                {runtime && (\n                  <span className=\"runtime\">{this.formatRuntime(runtime)}</span>\n                )}\n              </div>\n\n              <div className=\"user-interactions\">\n                <div className=\"user-score-section\">\n                  <div className=\"score-circle\">\n                    <span className=\"score-value\">{userScore}%</span>\n                  </div>\n                  <div className=\"vibe-buttons\">\n                    <Button \n                      icon \n                      circular \n                      size=\"small\"\n                      className={userVibe === 'angry' ? 'active' : ''}\n                      onClick={() => this.handleVibeClick('angry')}\n                    >\n                      <Icon name=\"frown\" />\n                    </Button>\n                    <Button \n                      icon \n                      circular \n                      size=\"small\"\n                      className={userVibe === 'thinking' ? 'active' : ''}\n                      onClick={() => this.handleVibeClick('thinking')}\n                    >\n                      <Icon name=\"meh\" />\n                    </Button>\n                    <Button \n                      icon \n                      circular \n                      size=\"small\"\n                      className={userVibe === 'happy' ? 'active' : ''}\n                      onClick={() => this.handleVibeClick('happy')}\n                    >\n                      <Icon name=\"smile\" />\n                    </Button>\n                    <Button size=\"small\" className=\"vibe-button\">\n                      What's your Vibe?\n                    </Button>\n                  </div>\n                </div>\n\n                <div className=\"action-buttons\">\n                  <Button \n                    icon \n                    circular \n                    size=\"small\"\n                    className={isLiked ? 'liked' : ''}\n                    onClick={this.handleLike}\n                  >\n                    <Icon name={isLiked ? 'heart' : 'heart outline'} />\n                  </Button>\n                  <Button \n                    icon \n                    circular \n                    size=\"small\"\n                    className={isBookmarked ? 'bookmarked' : ''}\n                    onClick={this.handleBookmark}\n                  >\n                    <Icon name={isBookmarked ? 'bookmark' : 'bookmark outline'} />\n                  </Button>\n                  <Button icon circular size=\"small\">\n                    <Icon name=\"list\" />\n                  </Button>\n                  {trailerUrl && (\n                    <Button \n                      color=\"red\" \n                      size=\"small\"\n                      onClick={() => this.openVideoModal({ url: trailerUrl, name: 'Trailer' })}\n                    >\n                      <Icon name=\"play\" /> Play Trailer\n                    </Button>\n                  )}\n                </div>\n              </div>\n\n              {tagline && (\n                <div className=\"tagline\">\n                  <em>{tagline}</em>\n                </div>\n              )}\n\n              {overview && (\n                <div className=\"overview-section\">\n                  <Header as=\"h3\">Overview</Header>\n                  <p>{overview}</p>\n                </div>\n              )}\n\n              {(directors.length > 0 || writers.length > 0) && (\n                <div className=\"crew-section\">\n                  {directors.length > 0 && (\n                    <div className=\"crew-group\">\n                      <strong>Director{directors.length > 1 ? 's' : ''}: </strong>\n                      {directors.map((d, idx) => (\n                        <span key={d.id}>\n                          {d.name}{idx < directors.length - 1 ? ', ' : ''}\n                        </span>\n                      ))}\n                    </div>\n                  )}\n                  {writers.length > 0 && (\n                    <div className=\"crew-group\">\n                      <strong>Writer{writers.length > 1 ? 's' : ''}: </strong>\n                      {writers.map((w, idx) => (\n                        <span key={w.id}>\n                          {w.name}{idx < writers.length - 1 ? ', ' : ''}\n                        </span>\n                      ))}\n                    </div>\n                  )}\n                </div>\n              )}\n\n              {/* External Links */}\n              <div className=\"external-links\" style={{ marginTop: '20px' }}>\n                {imdbId && (\n                  <Button \n                    as=\"a\" \n                    href={`https://www.imdb.com/title/${imdbId}`} \n                    target=\"_blank\"\n                    size=\"small\"\n                  >\n                    <Icon name=\"imdb\" /> IMDb\n                  </Button>\n                )}\n                {homepage && (\n                  <Button \n                    as=\"a\" \n                    href={homepage} \n                    target=\"_blank\"\n                    size=\"small\"\n                  >\n                    <Icon name=\"home\" /> Homepage\n                  </Button>\n                )}\n                <div className=\"social-links\" style={{ marginTop: '10px' }}>\n                  <Button icon circular size=\"small\">\n                    <Icon name=\"facebook\" />\n                  </Button>\n                  <Button icon circular size=\"small\">\n                    <Icon name=\"twitter\" />\n                  </Button>\n                  <Button icon circular size=\"small\">\n                    <Icon name=\"instagram\" />\n                  </Button>\n                  <Button icon circular size=\"small\">\n                    <Icon name=\"linkify\" />\n                  </Button>\n                </div>\n              </div>\n            </Grid.Column>\n          </Grid.Row>\n        </Grid>\n      </div>\n    );\n  };\n\n  renderCastCrew = () => {\n    const { enhanced } = this.props;\n    const hasEnhanced = enhanced && Object.keys(enhanced).length > 0;\n    \n    if (!hasEnhanced) {\n      return <div>No cast and crew information available.</div>;\n    }\n\n    const fullCast = enhanced.full_cast || enhanced.cast || [];\n    const allCrew = enhanced.all_crew || [];\n\n    // Group crew by department\n    const crewByDept = {};\n    allCrew.forEach(member => {\n      const dept = member.department || 'Other';\n      if (!crewByDept[dept]) {\n        crewByDept[dept] = [];\n      }\n      crewByDept[dept].push(member);\n    });\n\n    return (\n      <div className=\"cast-crew-tab\">\n        <Header as=\"h2\">Cast</Header>\n        <div className=\"cast-container\">\n          {fullCast.map((actor) => (\n            <div key={actor.id} className=\"cast-member\">\n              {actor.profile_path ? (\n                <Image \n                  src={actor.profile_path} \n                  alt={actor.name}\n                  className=\"cast-photo\"\n                  circular\n                  onError={(e) => {\n                    e.target.style.display = 'none';\n                  }}\n                />\n              ) : (\n                <div className=\"cast-photo-placeholder\">\n                  <Icon name=\"user\" />\n                </div>\n              )}\n              <div className=\"cast-name\">{actor.name}</div>\n              <div className=\"cast-character\">{actor.character}</div>\n            </div>\n          ))}\n        </div>\n\n        <Divider />\n\n        <Header as=\"h2\">Crew</Header>\n        {Object.keys(crewByDept).map(dept => (\n          <div key={dept} style={{ marginBottom: '30px' }}>\n            <Header as=\"h3\">{dept}</Header>\n            <div className=\"crew-grid\">\n              {crewByDept[dept].map((member) => (\n                <div key={`${member.id}-${member.job}`} className=\"crew-member\">\n                  {member.profile_path ? (\n                    <Image \n                      src={member.profile_path} \n                      alt={member.name}\n                      className=\"crew-photo\"\n                      circular\n                      size=\"small\"\n                    />\n                  ) : (\n                    <div className=\"crew-photo-placeholder\">\n                      <Icon name=\"user\" />\n                    </div>\n                  )}\n                  <div className=\"crew-name\">{member.name}</div>\n                  <div className=\"crew-job\">{member.job}</div>\n                </div>\n              ))}\n            </div>\n          </div>\n        ))}\n      </div>\n    );\n  };\n\n  renderReviews = () => {\n    const { enhanced } = this.props;\n    const hasEnhanced = enhanced && Object.keys(enhanced).length > 0;\n    const reviews = hasEnhanced ? (enhanced.reviews || []) : [];\n\n    if (reviews.length === 0) {\n      return <div>No reviews available.</div>;\n    }\n\n    return (\n      <div className=\"reviews-tab\">\n        <Header as=\"h2\">Reviews ({reviews.length})</Header>\n        {reviews.map((review) => (\n          <Card key={review.id} fluid className=\"review-card\">\n            <Card.Content>\n              <div className=\"review-header\">\n                {review.author_details.avatar_path ? (\n                  <Image \n                    src={review.author_details.avatar_path} \n                    circular \n                    size=\"mini\"\n                    floated=\"left\"\n                  />\n                ) : (\n                  <Icon name=\"user circle\" size=\"large\" floated=\"left\" />\n                )}\n                <div>\n                  <Card.Header>\n                    {review.author_details.name || review.author}\n                    {review.author_details.rating && (\n                      <Rating \n                        icon=\"star\" \n                        defaultRating={review.author_details.rating / 2} \n                        maxRating={5} \n                        disabled\n                        size=\"mini\"\n                        style={{ marginLeft: '10px' }}\n                      />\n                    )}\n                  </Card.Header>\n                  <Card.Meta>{this.formatReviewDate(review.created_at)}</Card.Meta>\n                </div>\n              </div>\n              <Card.Description>\n                <p style={{ whiteSpace: 'pre-wrap', marginTop: '15px' }}>\n                  {review.content.length > 500 \n                    ? `${review.content.substring(0, 500)}...` \n                    : review.content}\n                </p>\n                {review.content.length > 500 && review.url && (\n                  <a href={review.url} target=\"_blank\" rel=\"noopener noreferrer\">\n                    Read full review <Icon name=\"external\" />\n                  </a>\n                )}\n              </Card.Description>\n            </Card.Content>\n          </Card>\n        ))}\n      </div>\n    );\n  };\n\n  renderSimilarMovies = () => {\n    const { enhanced } = this.props;\n    const hasEnhanced = enhanced && Object.keys(enhanced).length > 0;\n    const similar = hasEnhanced ? (enhanced.similar_movies || []) : [];\n    const recommended = hasEnhanced ? (enhanced.recommended_movies || []) : [];\n\n    return (\n      <div className=\"similar-movies-tab\">\n        {similar.length > 0 && (\n          <>\n            <Header as=\"h2\">Similar Movies</Header>\n            <div className=\"movies-grid\">\n              {similar.map((movie) => (\n                <Card \n                  key={movie.id} \n                  className=\"movie-card\"\n                  onClick={() => window.location.reload()} // Would navigate to movie\n                >\n                  {movie.poster_path ? (\n                    <Image src={movie.poster_path} wrapped />\n                  ) : (\n                    <div className=\"movie-card-placeholder\">\n                      <Icon name=\"film\" size=\"big\" />\n                    </div>\n                  )}\n                  <Card.Content>\n                    <Card.Header>{movie.title}</Card.Header>\n                    <Card.Meta>\n                      {movie.release_date && new Date(movie.release_date).getFullYear()}\n                      {movie.vote_average && ` • ${movie.vote_average.toFixed(1)} ⭐`}\n                    </Card.Meta>\n                    {movie.overview && (\n                      <Card.Description>\n                        {movie.overview.length > 100 \n                          ? `${movie.overview.substring(0, 100)}...` \n                          : movie.overview}\n                      </Card.Description>\n                    )}\n                  </Card.Content>\n                </Card>\n              ))}\n            </div>\n          </>\n        )}\n\n        {recommended.length > 0 && (\n          <>\n            <Divider />\n            <Header as=\"h2\">Recommended Movies</Header>\n            <div className=\"movies-grid\">\n              {recommended.map((movie) => (\n                <Card \n                  key={movie.id} \n                  className=\"movie-card\"\n                  onClick={() => window.location.reload()}\n                >\n                  {movie.poster_path ? (\n                    <Image src={movie.poster_path} wrapped />\n                  ) : (\n                    <div className=\"movie-card-placeholder\">\n                      <Icon name=\"film\" size=\"big\" />\n                    </div>\n                  )}\n                  <Card.Content>\n                    <Card.Header>{movie.title}</Card.Header>\n                    <Card.Meta>\n                      {movie.release_date && new Date(movie.release_date).getFullYear()}\n                      {movie.vote_average && ` • ${movie.vote_average.toFixed(1)} ⭐`}\n                    </Card.Meta>\n                    {movie.overview && (\n                      <Card.Description>\n                        {movie.overview.length > 100 \n                          ? `${movie.overview.substring(0, 100)}...` \n                          : movie.overview}\n                      </Card.Description>\n                    )}\n                  </Card.Content>\n                </Card>\n              ))}\n            </div>\n          </>\n        )}\n\n        {similar.length === 0 && recommended.length === 0 && (\n          <div>No similar or recommended movies available.</div>\n        )}\n      </div>\n    );\n  };\n\n  renderImages = () => {\n    const { enhanced } = this.props;\n    const hasEnhanced = enhanced && Object.keys(enhanced).length > 0;\n    const images = hasEnhanced ? (enhanced.images || {}) : {};\n    const posters = images.posters || [];\n    const backdrops = images.backdrops || [];\n\n    return (\n      <div className=\"images-tab\">\n        {posters.length > 0 && (\n          <>\n            <Header as=\"h2\">Posters ({posters.length})</Header>\n            <div className=\"images-grid\">\n              {posters.map((img, idx) => (\n                <div \n                  key={idx} \n                  className=\"image-item\"\n                  onClick={() => this.openImageModal(img)}\n                >\n                  <Image \n                    src={img.file_path} \n                    alt={`Poster ${idx + 1}`}\n                    className=\"gallery-image\"\n                  />\n                </div>\n              ))}\n            </div>\n          </>\n        )}\n\n        {backdrops.length > 0 && (\n          <>\n            <Divider />\n            <Header as=\"h2\">Backdrops ({backdrops.length})</Header>\n            <div className=\"images-grid\">\n              {backdrops.map((img, idx) => (\n                <div \n                  key={idx} \n                  className=\"image-item\"\n                  onClick={() => this.openImageModal(img)}\n                >\n                  <Image \n                    src={img.file_path} \n                    alt={`Backdrop ${idx + 1}`}\n                    className=\"gallery-image\"\n                  />\n                </div>\n              ))}\n            </div>\n          </>\n        )}\n\n        {posters.length === 0 && backdrops.length === 0 && (\n          <div>No images available.</div>\n        )}\n      </div>\n    );\n  };\n\n  renderVideos = () => {\n    const { enhanced } = this.props;\n    const hasEnhanced = enhanced && Object.keys(enhanced).length > 0;\n    const videos = hasEnhanced ? (enhanced.videos || []) : [];\n\n    if (videos.length === 0) {\n      return <div>No videos available.</div>;\n    }\n\n    // Group videos by type\n    const videosByType = {};\n    videos.forEach(video => {\n      const type = video.type || 'Other';\n      if (!videosByType[type]) {\n        videosByType[type] = [];\n      }\n      videosByType[type].push(video);\n    });\n\n    return (\n      <div className=\"videos-tab\">\n        {Object.keys(videosByType).map(type => (\n          <div key={type} style={{ marginBottom: '30px' }}>\n            <Header as=\"h2\">{type}s ({videosByType[type].length})</Header>\n            <div className=\"videos-grid\">\n              {videosByType[type].map((video) => (\n                <Card \n                  key={video.id} \n                  className=\"video-card\"\n                  onClick={() => this.openVideoModal(video)}\n                >\n                  {video.thumbnail && (\n                    <div className=\"video-thumbnail\">\n                      <Image src={video.thumbnail} />\n                      <div className=\"play-overlay\">\n                        <Icon name=\"play\" size=\"big\" />\n                      </div>\n                    </div>\n                  )}\n                  <Card.Content>\n                    <Card.Header>{video.name}</Card.Header>\n                  </Card.Content>\n                </Card>\n              ))}\n            </div>\n          </div>\n        ))}\n      </div>\n    );\n  };\n\n  renderWatchProviders = () => {\n    const { enhanced } = this.props;\n    const hasEnhanced = enhanced && Object.keys(enhanced).length > 0;\n    const providers = hasEnhanced ? (enhanced.watch_providers || {}) : {};\n\n    const buy = providers.buy || [];\n    const rent = providers.rent || [];\n    const flatrate = providers.flatrate || [];\n\n    if (buy.length === 0 && rent.length === 0 && flatrate.length === 0) {\n      return (\n        <div className=\"watch-providers-tab\">\n          <div>No watch providers available for this movie.</div>\n        </div>\n      );\n    }\n\n    return (\n      <div className=\"watch-providers-tab\">\n        {flatrate.length > 0 && (\n          <>\n            <Header as=\"h2\">Stream</Header>\n            <div className=\"providers-grid\">\n              {flatrate.map((provider) => (\n                <div key={provider.provider_id} className=\"provider-item\">\n                  {provider.logo_path ? (\n                    <Image src={provider.logo_path} size=\"small\" />\n                  ) : (\n                    <div className=\"provider-placeholder\">\n                      <Icon name=\"tv\" />\n                    </div>\n                  )}\n                  <div className=\"provider-name\">{provider.provider_name}</div>\n                </div>\n              ))}\n            </div>\n          </>\n        )}\n\n        {rent.length > 0 && (\n          <>\n            <Divider />\n            <Header as=\"h2\">Rent</Header>\n            <div className=\"providers-grid\">\n              {rent.map((provider) => (\n                <div key={provider.provider_id} className=\"provider-item\">\n                  {provider.logo_path ? (\n                    <Image src={provider.logo_path} size=\"small\" />\n                  ) : (\n                    <div className=\"provider-placeholder\">\n                      <Icon name=\"tv\" />\n                    </div>\n                  )}\n                  <div className=\"provider-name\">{provider.provider_name}</div>\n                </div>\n              ))}\n            </div>\n          </>\n        )}\n\n        {buy.length > 0 && (\n          <>\n            <Divider />\n            <Header as=\"h2\">Buy</Header>\n            <div className=\"providers-grid\">\n              {buy.map((provider) => (\n                <div key={provider.provider_id} className=\"provider-item\">\n                  {provider.logo_path ? (\n                    <Image src={provider.logo_path} size=\"small\" />\n                  ) : (\n                    <div className=\"provider-placeholder\">\n                      <Icon name=\"tv\" />\n                    </div>\n                  )}\n                  <div className=\"provider-name\">{provider.provider_name}</div>\n                </div>\n              ))}\n            </div>\n          </>\n        )}\n      </div>\n    );\n  };\n\n  renderDetails = () => {\n    const { movie, enhanced } = this.props;\n    const hasEnhanced = enhanced && Object.keys(enhanced).length > 0;\n\n    if (!hasEnhanced) {\n      return <div>No additional details available.</div>;\n    }\n\n    const status = enhanced.status || '';\n    const originalLanguage = enhanced.original_language || '';\n    const budget = enhanced.budget || null;\n    const revenue = enhanced.revenue || null;\n    const productionCompanies = enhanced.production_companies || [];\n    const productionCountries = enhanced.production_countries || [];\n    const spokenLanguages = enhanced.spoken_languages || [];\n    const keywords = enhanced.keywords || [];\n    const voteAverage = enhanced.vote_average || null;\n    const voteCount = enhanced.vote_count || null;\n\n    return (\n      <div className=\"details-tab\">\n        <Grid>\n          <Grid.Row>\n            <Grid.Column width={8}>\n              <Segment>\n                <Header as=\"h3\">Status</Header>\n                <p>{status || 'N/A'}</p>\n\n                <Header as=\"h3\">Original Language</Header>\n                <p>{originalLanguage ? originalLanguage.toUpperCase() : 'N/A'}</p>\n\n                <Header as=\"h3\">Budget</Header>\n                <p>{this.formatCurrency(budget)}</p>\n\n                <Header as=\"h3\">Revenue</Header>\n                <p>{this.formatCurrency(revenue)}</p>\n\n                {voteAverage && (\n                  <>\n                    <Header as=\"h3\">TMDB Rating</Header>\n                    <p>\n                      <Rating \n                        icon=\"star\" \n                        defaultRating={voteAverage / 2} \n                        maxRating={5} \n                        disabled\n                      />\n                      {' '}\n                      {voteAverage.toFixed(1)}/10 ({voteCount?.toLocaleString()} votes)\n                    </p>\n                  </>\n                )}\n              </Segment>\n            </Grid.Column>\n\n            <Grid.Column width={8}>\n              <Segment>\n                {productionCompanies.length > 0 && (\n                  <>\n                    <Header as=\"h3\">Production Companies</Header>\n                    <ul>\n                      {productionCompanies.map((company, idx) => (\n                        <li key={idx}>{company}</li>\n                      ))}\n                    </ul>\n                  </>\n                )}\n\n                {productionCountries.length > 0 && (\n                  <>\n                    <Header as=\"h3\">Production Countries</Header>\n                    <ul>\n                      {productionCountries.map((country, idx) => (\n                        <li key={idx}>{country}</li>\n                      ))}\n                    </ul>\n                  </>\n                )}\n\n                {spokenLanguages.length > 0 && (\n                  <>\n                    <Header as=\"h3\">Spoken Languages</Header>\n                    <ul>\n                      {spokenLanguages.map((lang, idx) => (\n                        <li key={idx}>{lang}</li>\n                      ))}\n                    </ul>\n                  </>\n                )}\n\n                {keywords.length > 0 && (\n                  <>\n                    <Header as=\"h3\">Keywords</Header>\n                    <div className=\"keywords-container\">\n                      {keywords.map((keyword, idx) => (\n                        <Label key={idx} size=\"small\">{keyword}</Label>\n                      ))}\n                    </div>\n                  </>\n                )}\n              </Segment>\n            </Grid.Column>\n          </Grid.Row>\n        </Grid>\n      </div>\n    );\n  };\n\n  render() {\n    const { movie, enhanced } = this.props;\n    const { imageModalOpen, selectedImage, videoModalOpen, selectedVideo } = this.state;\n\n    if (!movie) return null;\n\n    const hasEnhanced = enhanced && Object.keys(enhanced).length > 0;\n    const backdropUrl = hasEnhanced && enhanced.backdrop_path;\n\n    const panes = [\n      { \n        menuItem: 'Overview', \n        render: () => <Tab.Pane>{this.renderOverview()}</Tab.Pane> \n      },\n      { \n        menuItem: 'Cast & Crew', \n        render: () => <Tab.Pane>{this.renderCastCrew()}</Tab.Pane> \n      },\n      { \n        menuItem: 'Reviews', \n        render: () => <Tab.Pane>{this.renderReviews()}</Tab.Pane> \n      },\n      { \n        menuItem: 'Similar Movies', \n        render: () => <Tab.Pane>{this.renderSimilarMovies()}</Tab.Pane> \n      },\n      { \n        menuItem: 'Images', \n        render: () => <Tab.Pane>{this.renderImages()}</Tab.Pane> \n      },\n      { \n        menuItem: 'Videos', \n        render: () => <Tab.Pane>{this.renderVideos()}</Tab.Pane> \n      },\n      { \n        menuItem: 'Watch', \n        render: () => <Tab.Pane>{this.renderWatchProviders()}</Tab.Pane> \n      },\n      { \n        menuItem: 'Details', \n        render: () => <Tab.Pane>{this.renderDetails()}</Tab.Pane> \n      },\n    ];\n\n    return (\n      <div className=\"movie-detail-container\">\n        {backdropUrl && (\n          <div \n            className=\"movie-backdrop\"\n            style={{ backgroundImage: `url(${backdropUrl})` }}\n          />\n        )}\n\n        <div className=\"movie-detail-content\">\n          <Tab \n            panes={panes} \n            menu={{ pointing: true, secondary: true, className: 'detail-tabs' }}\n          />\n        </div>\n\n        {/* Image Modal */}\n        <Modal\n          open={imageModalOpen}\n          onClose={this.closeImageModal}\n          size=\"large\"\n          closeIcon\n        >\n          <Modal.Content image>\n            {selectedImage && (\n              <Image \n                src={selectedImage.file_path} \n                wrapped \n                size=\"massive\"\n              />\n            )}\n          </Modal.Content>\n        </Modal>\n\n        {/* Video Modal */}\n        <Modal\n          open={videoModalOpen}\n          onClose={this.closeVideoModal}\n          size=\"large\"\n          closeIcon\n        >\n          <Modal.Header>\n            {selectedVideo?.name || 'Video'}\n          </Modal.Header>\n          <Modal.Content>\n            {selectedVideo?.key && (\n              <Embed\n                id={selectedVideo.key}\n                source=\"youtube\"\n                placeholder={selectedVideo.thumbnail}\n              />\n            )}\n          </Modal.Content>\n        </Modal>\n      </div>\n    );\n  }\n}\n\nexport default MovieDetailEnhanced;\n\n","/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/MovieGrid.js",[],"/Volumes/2-2-22/BEATZBYJAVA PRODUCTIONS WEB/MOVIE-RECOMMENDER/fullstack_recsys/react-front/src/components/MovieCard.js",["72"],{"ruleId":"73","replacedBy":"74"},{"ruleId":"75","replacedBy":"76"},{"ruleId":"77","severity":1,"message":"78","line":4,"column":8,"nodeType":"79","messageId":"80","endLine":4,"endColumn":22},{"ruleId":"77","severity":1,"message":"81","line":5,"column":8,"nodeType":"79","messageId":"80","endLine":5,"endColumn":20},{"ruleId":"77","severity":1,"message":"82","line":6,"column":8,"nodeType":"79","messageId":"80","endLine":6,"endColumn":22},{"ruleId":"77","severity":1,"message":"83","line":7,"column":8,"nodeType":"79","messageId":"80","endLine":7,"endColumn":18},{"ruleId":"77","severity":1,"message":"84","line":11,"column":35,"nodeType":"79","messageId":"80","endLine":11,"endColumn":39},{"ruleId":"77","severity":1,"message":"85","line":11,"column":56,"nodeType":"79","messageId":"80","endLine":11,"endColumn":61},{"ruleId":"77","severity":1,"message":"86","line":11,"column":79,"nodeType":"79","messageId":"80","endLine":11,"endColumn":86},{"ruleId":"77","severity":1,"message":"87","line":11,"column":98,"nodeType":"79","messageId":"80","endLine":11,"endColumn":105},{"ruleId":"77","severity":1,"message":"88","line":70,"column":43,"nodeType":"79","messageId":"80","endLine":70,"endColumn":55},{"ruleId":"77","severity":1,"message":"89","line":113,"column":11,"nodeType":"79","messageId":"80","endLine":113,"endColumn":22},{"ruleId":"77","severity":1,"message":"90","line":117,"column":11,"nodeType":"79","messageId":"80","endLine":117,"endColumn":15},{"ruleId":"77","severity":1,"message":"91","line":123,"column":11,"nodeType":"79","messageId":"80","endLine":123,"endColumn":17},{"ruleId":"77","severity":1,"message":"92","line":124,"column":11,"nodeType":"79","messageId":"80","endLine":124,"endColumn":18},{"ruleId":"77","severity":1,"message":"93","line":126,"column":11,"nodeType":"79","messageId":"80","endLine":126,"endColumn":22},{"ruleId":"77","severity":1,"message":"94","line":127,"column":11,"nodeType":"79","messageId":"80","endLine":127,"endColumn":20},{"ruleId":"77","severity":1,"message":"95","line":129,"column":11,"nodeType":"79","messageId":"80","endLine":129,"endColumn":17},{"ruleId":"77","severity":1,"message":"96","line":130,"column":11,"nodeType":"79","messageId":"80","endLine":130,"endColumn":27},{"ruleId":"77","severity":1,"message":"97","line":771,"column":13,"nodeType":"79","messageId":"80","endLine":771,"endColumn":18},{"ruleId":"77","severity":1,"message":"85","line":2,"column":37,"nodeType":"79","messageId":"80","endLine":2,"endColumn":42},"no-native-reassign",["98"],"no-negated-in-lhs",["99"],"no-unused-vars","'CandidateTable' is defined but never used.","Identifier","unusedVar","'ContextTable' is defined but never used.","'RecommendTable' is defined but never used.","'SearchForm' is defined but never used.","'Grid' is defined but never used.","'Label' is defined but never used.","'Segment' is defined but never used.","'Message' is defined but never used.","'isBookmarked' is assigned a value but never used.","'backdropUrl' is assigned a value but never used.","'cast' is assigned a value but never used.","'budget' is assigned a value but never used.","'revenue' is assigned a value but never used.","'voteAverage' is assigned a value but never used.","'voteCount' is assigned a value but never used.","'status' is assigned a value but never used.","'originalLanguage' is assigned a value but never used.","'movie' is assigned a value but never used.","no-global-assign","no-unsafe-negation"]