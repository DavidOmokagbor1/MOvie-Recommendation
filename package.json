{
  "name": "movie-recommender-fullstack",
  "version": "1.0.0",
  "description": "Fullstack Movie Recommender System",
  "private": true,
  "scripts": {
    "install:frontend": "cd fullstack_recsys/react-front && npm install --legacy-peer-deps",
    "install:backend": "pip3 install -r fullstack_recsys/backend/requirements.txt",
    "install:all": "npm run install:frontend && npm run install:backend",
    "start:frontend": "cd fullstack_recsys/react-front && npm start",
    "start:backend": "cd fullstack_recsys/backend && python3 run.py",
    "start:api": "cd fullstack_recsys/api && python3 api.py",
    "start:all": "cd fullstack_recsys/react-front && npm run start-all",
    "build": "cd fullstack_recsys/react-front && npm run build"
  }
}

